#!/usr/bin/env python3

import json
import os
import sys
import subprocess
import shutil
import tempfile

CONFIG_FILE = "/etc/hysteria/config.json"


# ==============================
# Colors
# ==============================

RED = "\033[1;31m"
GREEN = "\033[1;32m"
YELLOW = "\033[1;33m"
CYAN = "\033[1;36m"
BLUE = "\033[1;34m"
WHITE = "\033[1;37m"
RESET = "\033[0m"


# ==============================
# Header
# ==============================

def header():
    os.system("clear")

    print(f"{RED} Voltssh-X Hysteria by @Thongjuea{RESET}")
    print(f"{YELLOW}  ⌯ Hysteria Auth Password Manager{RESET}")
    print("    ------++------++------++------")
    print()


# ==============================
# Root
# ==============================

def check_root():
    if os.geteuid() != 0:
        print(f"{RED}กรุณารันด้วย root{RESET}")
        sys.exit(1)


# ==============================
# Config
# ==============================

def check_config():
    if not os.path.isfile(CONFIG_FILE):
        print(f"{RED}ไม่พบไฟล์ config:{RESET}")
        print(CONFIG_FILE)
        sys.exit(1)


def load_config():
    check_config()

    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            config = json.load(f)

        if not isinstance(config, dict):
            raise ValueError("config ต้องเป็น JSON object")

        return config

    except json.JSONDecodeError as e:
        print(f"{RED}config.json ไม่ถูกต้อง{RESET}")
        print()
        print(f"บรรทัด : {e.lineno}")
        print(f"คอลัมน์: {e.colno}")
        print(f"ตำแหน่ง: {e.pos}")
        print(f"ข้อความ: {e.msg}")
        sys.exit(1)

    except Exception as e:
        print(f"{RED}ไม่สามารถอ่าน config ได้{RESET}")
        print(e)
        sys.exit(1)


# ==============================
# Backup
# ==============================

def backup_config():
    backup = CONFIG_FILE + ".bak"

    try:
        shutil.copy2(CONFIG_FILE, backup)
        print(f"{GREEN}สร้าง backup แล้ว:{RESET} {backup}")
        return True

    except Exception as e:
        print(f"{RED}สร้าง backup ไม่สำเร็จ: {e}{RESET}")
        return False


# ==============================
# Save config
# ==============================

def save_config(config):
    try:
        # ตรวจสอบ JSON ก่อน
        json.dumps(config, ensure_ascii=False)

        directory = os.path.dirname(CONFIG_FILE)

        fd, temp_file = tempfile.mkstemp(
            prefix=".config.",
            suffix=".json",
            dir=directory
        )

        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(
                config,
                f,
                indent=2,
                ensure_ascii=False
            )
            f.write("\n")

        os.chmod(temp_file, 0o600)
        os.replace(temp_file, CONFIG_FILE)

        return True

    except Exception as e:
        print(f"{RED}บันทึก config ไม่สำเร็จ: {e}{RESET}")

        try:
            if os.path.exists(temp_file):
                os.remove(temp_file)
        except Exception:
            pass

        return False


# ==============================
# Get userpass
# ==============================

def get_userpass(config):
    auth = config.get("auth")

    if not isinstance(auth, dict):
        return {}

    userpass = auth.get("userpass")

    if not isinstance(userpass, dict):
        return {}

    return userpass


# ==============================
# Ensure auth structure
# ==============================

def ensure_auth(config):
    if not isinstance(config.get("auth"), dict):
        config["auth"] = {}

    config["auth"]["type"] = "userpass"

    if not isinstance(config["auth"].get("userpass"), dict):
        config["auth"]["userpass"] = {}

    return config["auth"]["userpass"]


# ==============================
# Add password
# ==============================

def add_password():

    config = load_config()

    userpass = ensure_auth(config)

    print()
    print(f"{CYAN}========== เพิ่มรหัสผ่าน AUTH =========={RESET}")
    print()

    username = input("  * Username: ").strip()

    if not username:
        print(f"{RED}Username ห้ามว่าง{RESET}")
        return

    if username in userpass:
        print(f"{YELLOW}Username นี้มีอยู่แล้ว{RESET}")
        return

    password = input("  * Password: ").strip()

    if not password:
        print(f"{RED}Password ห้ามว่าง{RESET}")
        return

    if len(password) < 10:
        print(f"{RED}Password ต้องมีอย่างน้อย 10 ตัวอักษร{RESET}")
        return

    if password in userpass.values():
        print(f"{YELLOW}Password นี้มีอยู่แล้ว{RESET}")
        return

    print()
    print(f"{YELLOW}กำลังบันทึก...{RESET}")

    if not backup_config():
        return

    userpass[username] = password

    if save_config(config):

        print()
        print(f"{GREEN}================================{RESET}")
        print(f"{GREEN}เพิ่ม AUTH สำเร็จ ✓{RESET}")
        print(f"{WHITE}Username: {username}{RESET}")
        print(f"{WHITE}Password: {password}{RESET}")
        print(f"{GREEN}================================{RESET}")

        restart_service()


# ==============================
# List passwords
# ==============================

def list_passwords():

    config = load_config()

    userpass = get_userpass(config)

    print()
    print(f"{CYAN}========== รายการ AUTH =========={RESET}")
    print()

    if not userpass:
        print(f"{YELLOW}ยังไม่มี Username / Password{RESET}")
        return

    for idx, (username, password) in enumerate(userpass.items(), 1):

        print(
            f"{WHITE}{idx}. "
            f"Username: {username} "
            f"| Password: {password}{RESET}"
        )

    print()
    print(f"{GREEN}รวมทั้งหมด: {len(userpass)} รายการ{RESET}")


# ==============================
# Delete password
# ==============================

def delete_password():

    config = load_config()

    userpass = get_userpass(config)

    if not userpass:
        print(f"{YELLOW}ไม่มี AUTH ให้ลบ{RESET}")
        return

    print()
    print(f"{CYAN}========== ลบ AUTH =========={RESET}")
    print()

    items = list(userpass.items())

    for idx, (username, password) in enumerate(items, 1):

        print(
            f"{idx}. "
            f"Username: {username} "
            f"| Password: {password}"
        )

    print()

    choice = input("เลือกหมายเลขที่ต้องการลบ: ").strip()

    try:
        idx = int(choice)

    except ValueError:
        print(f"{RED}กรุณาใส่หมายเลข{RESET}")
        return

    if idx < 1 or idx > len(items):
        print(f"{RED}หมายเลขไม่ถูกต้อง{RESET}")
        return

    username, password = items[idx - 1]

    print()
    print(f"{YELLOW}Username: {username}{RESET}")

    confirm = input("ยืนยันการลบ? [y/N]: ").strip().lower()

    if confirm != "y":
        print(f"{YELLOW}ยกเลิก{RESET}")
        return

    if not backup_config():
        return

    del userpass[username]

    if save_config(config):

        print()
        print(f"{GREEN}ลบ AUTH สำเร็จ ✓{RESET}")

        restart_service()


# ==============================
# Delete all
# ==============================

def delete_all():

    config = load_config()

    userpass = get_userpass(config)

    if not userpass:
        print(f"{YELLOW}ไม่มี AUTH ให้ลบ{RESET}")
        return

    print()
    print(
        f"{RED}คุณกำลังจะลบ AUTH ทั้งหมด "
        f"{len(userpass)} รายการ{RESET}"
    )

    confirm = input("พิมพ์ DELETE เพื่อยืนยัน: ").strip()

    if confirm != "DELETE":
        print(f"{YELLOW}ยกเลิก{RESET}")
        return

    if not backup_config():
        return

    config["auth"]["userpass"] = {}

    if save_config(config):

        print()
        print(f"{GREEN}ลบ AUTH ทั้งหมดแล้ว ✓{RESET}")

        restart_service()


# ==============================
# Restart Hysteria
# ==============================

def restart_service():

    print()
    print(f"{YELLOW}กำลังตรวจสอบ config...{RESET}")

    # ตรวจสอบ JSON ก่อน
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            json.load(f)

    except Exception as e:
        print(f"{RED}JSON ไม่ถูกต้อง: {e}{RESET}")
        return

    print(f"{GREEN}JSON OK ✓{RESET}")

    print(f"{YELLOW}กำลัง restart Hysteria...{RESET}")

    result = subprocess.run(
        ["systemctl", "restart", "hysteria"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True
    )

    if result.returncode != 0:

        print(f"{RED}Restart ไม่สำเร็จ ✗{RESET}")

        if result.stderr:
            print(result.stderr.strip())

        return

    status = subprocess.run(
        ["systemctl", "is-active", "hysteria"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True
    )

    if status.stdout.strip() == "active":

        print(f"{GREEN}Hysteria ทำงานปกติ ✓{RESET}")

    else:

        print(f"{RED}Hysteria ไม่ได้ทำงาน ✗{RESET}")

        subprocess.run(
            ["systemctl", "status", "hysteria", "--no-pager", "-l"]
        )


# ==============================
# Main menu
# ==============================

def menu():

    while True:

        header()

        config = load_config()

        userpass = get_userpass(config)

        print(f"{CYAN}========== Hysteria Password Manager =========={RESET}")
        print()

        print(
            f"  จำนวน AUTH: "
            f"{GREEN}{len(userpass)}{RESET}"
        )

        print()

        print("  1. เพิ่มรหัสผ่าน AUTH")
        print("  2. ดูรหัสผ่าน AUTH")
        print("  3. ลบรหัสผ่าน AUTH")
        print("  4. ลบรหัสผ่านทั้งหมด")
        print("  5. รีสตาร์ท Hysteria")
        print("  0. ออก")

        print()
        print("================================================")
        print()

        choice = input("เลือกเมนู: ").strip()

        if choice == "1":

            add_password()

        elif choice == "2":

            list_passwords()

        elif choice == "3":

            delete_password()

        elif choice == "4":

            delete_all()

        elif choice == "5":

            restart_service()

        elif choice == "0":

            print("ออกจากโปรแกรม")
            break

        else:

            print(f"{RED}ตัวเลือกไม่ถูกต้อง{RESET}")

        input("\nกด Enter เพื่อกลับเมนู...")


# ==============================
# Run
# ==============================

if __name__ == "__main__":

    check_root()
    menu()
